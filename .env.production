# Production Environment
NODE_ENV=production
PORT=3000

# Database - Update with your production MongoDB URI
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# CORS
CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# API
API_KEY=

# Logging
LOG_LEVEL=error
